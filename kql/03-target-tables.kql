// PURPOSE: Create clean tables for common reporting and analytics.
//
// Unlike RawTelemetry, these tables have predictable columns for values that
// the business has approved and understands. Automatic update policies will
// fill them whenever a new raw message arrives.
//
// ResidualTelemetry and ResidualZone are safety-net JSON columns. They retain
// fields that are present in a message but have not yet been promoted to a
// dedicated column. This is how a new field can arrive without breaking the
// table or disappearing from the data.

// One row represents one controller message.
.create-merge table ControllerTelemetry (
    MessageId:guid,
    EventTimestamp:datetime,
    TenantId:string,
    AssetId:string,
    DeviceId:string,
    SchemaVersion:int,
    ControllerStatus:string,
    EngineHours:real,
    FuelConsumption:real,
    ResidualTelemetry:dynamic,
    ProcessedAt:datetime
)

// One row represents one gateway message.
.create-merge table GatewayTelemetry (
    MessageId:guid,
    EventTimestamp:datetime,
    TenantId:string,
    AssetId:string,
    DeviceId:string,
    SchemaVersion:int,
    Hdop:real,
    PrimaryVoltage:real,
    Speed:real,
    FixType:string,
    SignalStrength:int,
    ResidualTelemetry:dynamic,
    ProcessedAt:datetime
)

// One row represents the main measurements from one cooling-unit message.
.create-merge table CoolingUnitTelemetry (
    MessageId:guid,
    EventTimestamp:datetime,
    TenantId:string,
    AssetId:string,
    DeviceId:string,
    SchemaVersion:int,
    ControllerStatus:string,
    FuelLevelPercent:real,
    AmbientTemperature:real,
    NumberOfZones:int,
    ResidualTelemetry:dynamic,
    ProcessedAt:datetime
)

// One cooling-unit message can describe several zones. This table stores one
// row per zone instead of creating a changing set of Zone1, Zone2, and Zone3
// columns. That keeps the design stable when the number of zones varies.
.create-merge table CoolingUnitZones (
    MessageId:guid,
    EventTimestamp:datetime,
    TenantId:string,
    AssetId:string,
    DeviceId:string,
    ZoneId:int,
    IsDoorOpen:bool,
    IsActive:bool,
    OperatingMode:string,
    ReturnAirTemperature:real,
    DischargeAirTemperature:real,
    SetpointTemperature:real,
    ResidualZone:dynamic,
    ProcessedAt:datetime
)
