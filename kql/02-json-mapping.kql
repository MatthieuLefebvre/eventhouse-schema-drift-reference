// PURPOSE: Explain how fields in incoming JSON fill the RawTelemetry columns.
//
// Each Path points to a named value in the incoming message. For example,
// $.id means "take the value named id at the top of the JSON document."
//
// The final rule copies the whole document into RawRecord, then
// DropMappedFields removes values already placed in dedicated columns. This
// avoids keeping two copies of the known envelope values while preserving the
// payload and any future fields that do not yet have columns.
.create-or-alter table RawTelemetry ingestion json mapping 'RawTelemetryJsonMapping'
```
[
  {"Column":"MessageId",      "Properties":{"Path":"$.id"}},
  {"Column":"EventTimestamp", "Properties":{"Path":"$.timestamp"}},
  {"Column":"MessageType",    "Properties":{"Path":"$.messageType"}},
  {"Column":"SourceType",     "Properties":{"Path":"$.sourceType"}},
  {"Column":"TenantId",       "Properties":{"Path":"$.tenantId"}},
  {"Column":"AssetId",        "Properties":{"Path":"$.assetId"}},
  {"Column":"DeviceId",       "Properties":{"Path":"$.deviceId"}},
  {"Column":"SchemaVersion",  "Properties":{"Path":"$.schemaVersion"}},
  {"Column":"RawRecord",      "Properties":{"Path":"$", "Transform":"DropMappedFields"}}
]
```
