// PURPOSE: Reset the demonstration environment.
//
// WARNING: This file permanently removes every policy, saved query, summary
// view, and table created by this project. Removing a table also removes the
// data stored in it. Run this file only in a demonstration database that can
// safely be rebuilt from scratch.
//
// The policies are removed first so no automatic processing is left pointing
// at objects that are about to be deleted. The remaining commands then remove
// the saved queries, optional latest-record view, and tables.
.delete table TelemetryDriftObservations policy update
.delete table CoolingUnitZones policy update
.delete table CoolingUnitTelemetry policy update
.delete table GatewayTelemetry policy update
.delete table ControllerTelemetry policy update
.drop function ReviewTelemetryDrift ifexists
.drop function DetectTelemetryDrift ifexists
.drop function TransformCoolingUnitZones ifexists
.drop function TransformCoolingUnitTelemetry ifexists
.drop function TransformGatewayTelemetry ifexists
.drop function TransformControllerTelemetry ifexists
.drop materialized-view ControllerTelemetryLatest ifexists
.drop table TelemetryDriftObservations ifexists
.drop table CoolingUnitZones ifexists
.drop table CoolingUnitTelemetry ifexists
.drop table GatewayTelemetry ifexists
.drop table ControllerTelemetry ifexists
.drop table RawTelemetry ifexists
